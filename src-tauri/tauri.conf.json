{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "悬浮倒计时",
  "mainBinaryName": "float-countdown",
  "version": "2.1.2",
  "identifier": "com.dario.floatcountdown",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; media-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.ttf",
          "**/*.otf",
          "**/*.woff",
          "**/*.woff2",
          "**/*.ttc"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "悬浮倒计时",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}